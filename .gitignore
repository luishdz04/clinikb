# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# mcp (contiene tokens de acceso)
.mcp.json

# supabase
/supabase/.temp
/supabase/functions/.temp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# otros proyectos
muscleupgym-renueve-main/

# docs de antd generadas por el CLI (~2MB, regenerables)
ant.design*.txt

# ajustes locales de Claude Code (por máquina, no compartibles)
.claude/settings.local.json
